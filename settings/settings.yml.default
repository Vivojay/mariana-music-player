# Factory defaults. Existing user values are preserved during additive migration.

display items count:
  general:
    fallback: 10
    maximum: 100
  youtube-search results:
    maximum: 15

download:
  downloads folder: ~/Music
  make a separate mariana folder within "downloads folder": true
  quality:
    audio only: 1
    video with audio:
      audio: 1
      video: 1
  type: video

include music folder in library: true
loglevel: 3
show about: true
show banner: true
visible: true
editor path: C:\WINDOWS\system32\notepad.exe
get related songs: true
vlc path:

lyrics:
  use solid color bg: false
  webview wallpaper:
    wallpaper folder:
    wallpaper name or number:
  solid color bg:
    color: '#121212'
