# Factory defaults. Existing user values are preserved during additive migration.

display items count:
  general:
    fallback: 10
    maximum: 100
  youtube-search results:
    maximum: 15

download:
  downloads folder: ~/Music
  make a separate mariana folder within "downloads folder": true
  quality:
    audio only: 1
    video with audio:
      audio: 1
      video: 1
  type: video

include music folder in library: true
loglevel: 3
show about: true
show banner: true
visible: true
editor path:
get related songs: true

media tools:
  ffmpeg bin:
  fpcalc bin:

playback:
  crossfade seconds: 0
  buffer seconds: 8

library:
  scan mode: staged
  watch: true
  reconcile hours: 6
  network poll seconds: 600
  tombstones: retain
  probe workers: 2
  deep workers: 1
  online enrichment: false

sources:
  allowed protocols:
    - file
    - http
    - https
  youtube:
    browser profile:

identification:
  acoustid api key:

radio:
  health probe seconds: 5

recommendations:
  autofill: false
  exploration: 0.10
  mmr diversity: 0.75
  listenbrainz token:

lyrics:
  use solid color bg: false
  webview wallpaper:
    wallpaper folder:
    wallpaper name or number:
  solid color bg:
    color: '#121212'
